     movesTowardEnemy) (- uIsBase movesTowardEnemyMajor)
     myResources))
Tree 2:
 aProducesBuilding
Tree 3:
 (+ (if> (max movesTowardEnemyBase gameTimeK)
     aProducesCombat movesTowardEnemy aIsAttack)
     movesTowardEnemyMajor)
