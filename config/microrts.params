# =====================================================================
# microrts.params -- evolve a microRTS scorer  (Phase 3b)
#
#   java -cp "out;lib/*;lib/bots/*" ec.Evolve -file config/microrts.params
#
# CURRICULUM STAGE 3 of 3: PassiveAI + RandomBiasedAI + WorkerRush.
#
# THIS REVISION: win reward is now MULTIPLICATIVE (see eval.problem.win-bonus),
# eval range recalibrated from observed data, stage advanced to 3.
# =====================================================================

parent.0 = @ec.gp.koza.GPKozaDefaults koza.params

# ---------------------------------------------------------------------
# Seeds -- ONE PER THREAD, NOT ONE PER RUN
# ---------------------------------------------------------------------
# ECJ allocates max(evalthreads, breedthreads) random number generators and demands a
# seed for each. With evalthreads > 1 and only seed.0 defined, setup fails with an
# undefined-seed error before generation 0. Eight are listed so evalthreads can be
# raised to anything up to 8 without touching this block; surplus lines are unused.
#
# Do NOT use 'seed.n = time'.
#
# SCOPE OF THE REPRODUCIBILITY CLAIM. Verified 2026-09-12: two runs at seed.0 = 4242
# and evalthreads = 1 produced DIFFERENT populations. The only nondeterminism in that
# configuration is the opponent, so ai.RandomBiasedAI seeds its own RNG from the clock.
# Runs against deterministic opponents only are bit-for-bit reproducible; runs that
# include RandomBiasedAI are reproducible in distribution and must be reported across
# several seeds.
seed.0 = 4242
seed.1 = 4243
seed.2 = 4244
seed.3 = 4245
seed.4 = 4246
seed.5 = 4247
seed.6 = 4248
seed.7 = 4249

# ---------------------------------------------------------------------
# Threading
# ---------------------------------------------------------------------
# SAFE HERE, CHECKED: gp.Features holds no static mutable state -- every method reads
# only its arguments. eval.Panel holds none either, and loads a fresh PhysicalGameState
# per game rather than caching a parsed map. ECJ clones the Problem per eval thread and
# GPProblem.clone() deep-copies the GPData and the ADFStack, so each thread scores into
# its own ScoreData. MicroRTSProblem.clone() additionally hands each clone its own
# UnitTypeTable and EvaluationFunction, because Object.clone() would otherwise share one
# instance across every thread.
#
# Set to the PHYSICAL core count, not the logical count. Raise the seed list above if
# you go beyond 8.
evalthreads = 8

# Breeding stays single-threaded: it is a small fraction of runtime and keeping it on
# one RNG stream means the run is reproducible regardless of how evalthreads is set.
breedthreads = 1

state = ec.simple.SimpleEvolutionState
init = ec.gp.GPInitializer
finish = ec.simple.SimpleFinisher
breed = ec.simple.SimpleBreeder
eval = ec.simple.SimpleEvaluator
exch = ec.simple.SimpleExchanger

generations = 100
quit-on-run-complete = false
checkpoint = false
checkpoint-prefix = ec
checkpoint-modulo = 1

# ---------------------------------------------------------------------
# Population
# ---------------------------------------------------------------------
# 100 was too small. Eleven identical best-of-generation lines in a row is an exhausted
# gene pool, not a difficult search. 500 is affordable and is the standard Koza size.
pop.subpop.0.size = 500
pop.subpop.0.duplicate-retries = 100
pop.subpop.0.species = ec.gp.GPSpecies
pop.subpop.0.species.ind = ec.gp.GPIndividual
pop.subpop.0.species.fitness = ec.gp.koza.KozaFitness
pop.subpop.0.species.ind.numtrees = 1
pop.subpop.0.species.ind.tree.0 = ec.gp.GPTree
pop.subpop.0.species.ind.tree.0.tc = tc0

# Depth cap. Note that the 2026-09-12 run's best tree was 9 nodes at depth 3 -- that was
# NOT parsimony working, it was a dead fitness function producing no selection pressure
# at all. Expect real bloat to return now that fitness varies again; the earlier run
# that did have pressure pinned against this cap at 165 nodes.
gp.koza.xover.maxdepth = 12
gp.koza.mutate.maxdepth = 12

# ---------------------------------------------------------------------
# Function set
# ---------------------------------------------------------------------
# nc0 = terminal, nc2 = arity 2, nc4 = arity 4 (defined below for if>).
#
# TERMINALS: each FeatureNode binds by name to a static method in gp.Features.
# FeatureNode resolves parameters BY TYPE, so argument order in Features.java does not
# matter -- (GameState, Unit, int) and (Unit, GameState, int) both bind.
#
# SUFFICIENCY: whatever is not listed here, evolution cannot use. This list IS the
# GP's vocabulary.
#
# SUFFICIENCY, THE SHARPER VERSION -- ARGMAX EATS CONSTANT TERMS. EvolvedBot scores
# every legal action of a unit and takes the argmax. Any terminal that returns the same
# value for all of that unit's candidate actions contributes an identical amount to every
# score and therefore cannot change the choice. It can still be USEFUL inside an if> or a
# product, where it modulates an action-dependent term -- but on its own it steers
# nothing.
#
# Before func.25-28 existed, EVERY terminal here was constant across the four MOVE
# directions, so the tree scored all four moves identically and the argmax fell through
# to getUnitActions() list order. Movement was not under evolutionary control and the bot
# could only win reactively. Adding the direction terminals took the panel from 4W-6T-0L
# against two random opponents to 13 of 18 panel bots beaten, including 10-0 against
# PassiveAI, which was previously unbeatable. The sufficiency hypothesis was confirmed.
#
# STILL NOT LISTED, DELIBERATELY:
#   movesToward(Unit, UnitAction, int, int) -- two ints unresolvable from ScoreData.
#   mapArea -- a literal constant while training on a single map.
#   distEnemyBase, myUnitCount, myBarracksCount, uIsBarracks, uHpFrac, aIsNone -- held
#     back so the direction terminals could be tested alone. Now that the hypothesis has
#     resolved, these can be added; do it as a separate change from the fitness fix so
#     the two effects stay separable.

gp.fs.size = 1
gp.fs.0.name = f0
gp.fs.0.size = 29

# -- functions --
gp.fs.0.func.0 = gp.nodes.Add
gp.fs.0.func.0.nc = nc2
gp.fs.0.func.1 = gp.nodes.Sub
gp.fs.0.func.1.nc = nc2
gp.fs.0.func.2 = gp.nodes.Mul
gp.fs.0.func.2.nc = nc2
gp.fs.0.func.3 = gp.nodes.Div
gp.fs.0.func.3.nc = nc2
gp.fs.0.func.4 = gp.nodes.Min
gp.fs.0.func.4.nc = nc2
gp.fs.0.func.5 = gp.nodes.Max
gp.fs.0.func.5.nc = nc2
gp.fs.0.func.6 = gp.nodes.IfGreater
gp.fs.0.func.6.nc = nc4

# -- ephemeral random constants (the evolved scoring weights) --
gp.fs.0.func.7 = gp.nodes.ScoreERC
gp.fs.0.func.7.nc = nc0
gp.fs.0.func.7.range = 10.0

# -- terminals: action type --
gp.fs.0.func.8 = gp.nodes.FeatureNode
gp.fs.0.func.8.nc = nc0
gp.fs.0.func.8.feature = aIsMove
gp.fs.0.func.9 = gp.nodes.FeatureNode
gp.fs.0.func.9.nc = nc0
gp.fs.0.func.9.feature = aIsHarvest
gp.fs.0.func.10 = gp.nodes.FeatureNode
gp.fs.0.func.10.nc = nc0
gp.fs.0.func.10.feature = aIsReturn
gp.fs.0.func.11 = gp.nodes.FeatureNode
gp.fs.0.func.11.nc = nc0
gp.fs.0.func.11.feature = aIsProduce
gp.fs.0.func.12 = gp.nodes.FeatureNode
gp.fs.0.func.12.nc = nc0
gp.fs.0.func.12.feature = aIsAttack

# -- terminals: produce target --
gp.fs.0.func.13 = gp.nodes.FeatureNode
gp.fs.0.func.13.nc = nc0
gp.fs.0.func.13.feature = aProducesWorker
gp.fs.0.func.14 = gp.nodes.FeatureNode
gp.fs.0.func.14.nc = nc0
gp.fs.0.func.14.feature = aProducesCombat
gp.fs.0.func.15 = gp.nodes.FeatureNode
gp.fs.0.func.15.nc = nc0
gp.fs.0.func.15.feature = aProducesBuilding

# -- terminals: acting unit --
gp.fs.0.func.16 = gp.nodes.FeatureNode
gp.fs.0.func.16.nc = nc0
gp.fs.0.func.16.feature = uIsWorker
gp.fs.0.func.17 = gp.nodes.FeatureNode
gp.fs.0.func.17.nc = nc0
gp.fs.0.func.17.feature = uIsBase
gp.fs.0.func.18 = gp.nodes.FeatureNode
gp.fs.0.func.18.nc = nc0
gp.fs.0.func.18.feature = uIsCombat
gp.fs.0.func.19 = gp.nodes.FeatureNode
gp.fs.0.func.19.nc = nc0
gp.fs.0.func.19.feature = uCarrying

# -- terminals: economy and army --
gp.fs.0.func.20 = gp.nodes.FeatureNode
gp.fs.0.func.20.nc = nc0
gp.fs.0.func.20.feature = myResources
gp.fs.0.func.21 = gp.nodes.FeatureNode
gp.fs.0.func.21.nc = nc0
gp.fs.0.func.21.feature = myWorkerCount
gp.fs.0.func.22 = gp.nodes.FeatureNode
gp.fs.0.func.22.nc = nc0
gp.fs.0.func.22.feature = enemyUnitCount

# -- terminals: spatial (position only -- these gate, they do not steer) --
gp.fs.0.func.23 = gp.nodes.FeatureNode
gp.fs.0.func.23.nc = nc0
gp.fs.0.func.23.feature = distNearestEnemy
gp.fs.0.func.24 = gp.nodes.FeatureNode
gp.fs.0.func.24.nc = nc0
gp.fs.0.func.24.feature = distNearestResource

# -- terminals: DIRECTION (the only ones that separate one MOVE from another) --
gp.fs.0.func.25 = gp.nodes.FeatureNode
gp.fs.0.func.25.nc = nc0
gp.fs.0.func.25.feature = movesTowardEnemy
gp.fs.0.func.26 = gp.nodes.FeatureNode
gp.fs.0.func.26.nc = nc0
gp.fs.0.func.26.feature = movesTowardEnemyBase
gp.fs.0.func.27 = gp.nodes.FeatureNode
gp.fs.0.func.27.nc = nc0
gp.fs.0.func.27.feature = movesTowardMyBase
gp.fs.0.func.28 = gp.nodes.FeatureNode
gp.fs.0.func.28.nc = nc0
gp.fs.0.func.28.feature = movesTowardResource

# Arity-4 node constraint for if>. koza.params defines nc0..nc3 only.
gp.nc.size = 5
gp.nc.4 = ec.gp.GPNodeConstraints
gp.nc.4.name = nc4
gp.nc.4.returns = nil
gp.nc.4.size = 4
gp.nc.4.child.0 = nil
gp.nc.4.child.1 = nil
gp.nc.4.child.2 = nil
gp.nc.4.child.3 = nil

# ---------------------------------------------------------------------
# Parsimony pressure -- COMMENTED OUT, turn on if depth pins at 12
# ---------------------------------------------------------------------
# Double tournament: an inner tournament on fitness, an outer on size. Keeps selection
# pressure on fitness while breaking ties toward smaller trees, which is preferable to a
# hard size cap because it never discards a genuinely better big tree. Uncomment all four
# lines together.
#
# select.tournament = ec.parsimony.DoubleTournamentSelection
# select.tournament.size = 7
# select.tournament.size2 = 1.4
# select.tournament.do-length-first = false

# ---------------------------------------------------------------------
# The problem: what games get played
# ---------------------------------------------------------------------
eval.problem = gp.MicroRTSProblem
eval.problem.data = gp.ScoreData

# TRAINING opponents and maps only. Everything else stays held out for the report.
#
# CURRICULUM, NOW AT STAGE 3. WorkerRush was originally the ONLY training opponent, and
# that was the single biggest thing wrong with the earliest runs: no randomly generated
# tree beat it, so the entire population lived in the loss band from generation 0 and the
# only available gradient was "lose slightly less badly". Best-of-run sat at 2.37 for
# eleven straight generations.
#
# It is the right opponent NOW for the opposite reason. The current bot beats 13 of 18
# panel bots and loses 0-10 to WorkerRush and WorkerRushPlusPlus, so those two are the
# only remaining source of gradient -- everything else is already saturated at a win.
#
#   stage 1  PassiveAI
#   stage 2  PassiveAI, RandomBiasedAI
#   stage 3  PassiveAI, RandomBiasedAI, WorkerRush      <-- current
#
# Cost: PassiveAI and WorkerRush are deterministic (1 game per side), RandomBiasedAI is
# repeated 3x per side, so 2 + 6 + 2 = 10 games per individual.
eval.problem.opponents = PassiveAI, RandomBiasedAI, WorkerRush
eval.problem.maps = maps/8x8/basesWorkers8x8.xml
eval.problem.swap-sides = true

eval.problem.max-cycles = 3000

# ---------------------------------------------------------------------
# Fitness shaping (see the comment block in MicroRTSProblem)
# ---------------------------------------------------------------------
# Bands: win 0-1, draw 1-2, loss 2-3. These two only split the LOSS band between
# "survived longer" and "played better"; they are normalised to sum to 1.
eval.problem.speed-weight = 0.5
eval.problem.margin-weight = 0.25

# WIN REWARD -- A MULTIPLIER, NOT A SUBTRACTION. Fitness is scaled by
# (1 - win-bonus * win-fraction). Must be in [0.0, 1.0); 0.0 disables the reward.
#
# READ BEFORE CHANGING. This was subtracted rather than multiplied, and because a win
# already scores near 0.0 the subtraction drove every all-winning individual to the same
# clamped 0.0. A bot winning in 200 cycles and one winning in 2900 became identical, and
# the 2026-09-12 run spent 100 generations and 50,000 evaluations with zero selection
# pressure -- every generation reported Standardized=0.0 Hits=8 and the best-of-run was
# effectively a generation-0 random tree. Anything that can saturate will saturate
# exactly where the population ends up.
eval.problem.win-bonus = 0.5

# Contrast range for the quality term. Panel already normalises meanEval to [0,1] with
# 0.5 meaning an even game, so these bounds are not a unit conversion -- they stretch the
# narrow band real games occupy across the full range.
#
# RECALIBRATED from the 2026-09-12 stage-2 run, whose per-generation ranges spanned
# roughly [0.07, 0.97] with occasional CLAMPING verdicts at the top. Widened accordingly.
# Recalibrate again after this run: adding WorkerRush will shift the distribution
# downward, since the population now loses a third of its games.
eval.problem.eval-lo = 0.05
eval.problem.eval-hi = 1.00
eval.problem.calibrate-eval = true
eval.problem.repeats = 3

# ---------------------------------------------------------------------
# Statistics + end-of-run benchmark
# ---------------------------------------------------------------------
# NOTE ON '$': in ECJ a leading $ means "relative to the working directory"; without it
# the path resolves relative to the directory holding this params file. Keep the $.
# PowerShell also needs single quotes around any -p override containing one.
stat = gp.BenchmarkStatistics
stat.file = $results/microrts.stat

# 'all' runs the full 18-bot scripted panel -- deliberately much wider than the training
# opponents above, so the benchmark shows what generalises rather than what was fitted.
stat.bench-opponents = all
stat.bench-maps = maps/8x8/basesWorkers8x8.xml
stat.bench-games = 10
stat.bench-max-cycles = 3000
