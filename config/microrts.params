# =====================================================================
# microrts.params -- evolve a microRTS scorer  (Phase 3b)
#
#   .\evolve.ps1 config/microrts.params
#   java -cp "out;lib/*" ec.Evolve -file config/microrts.params
#
# CURRICULUM STAGE 1 of 3. This run trains against PassiveAI only. See the
# "TRAINING opponents" block near the bottom for what to change and when.
# =====================================================================

parent.0 = @ec.gp.koza.GPKozaDefaults koza.params

seed.0 = 4242

# Fitness evaluation is a full game, so this is the parameter that decides whether a
# run takes 20 minutes or 6 hours. ECJ clones the Problem per eval thread, so raising
# this is safe for OUR state -- but shared statics anywhere in Features are not.
# Set to your physical core count once a single-threaded run has been verified.
evalthreads = 1
breedthreads = 1

state = ec.simple.SimpleEvolutionState
init = ec.gp.GPInitializer
finish = ec.simple.SimpleFinisher
breed = ec.simple.SimpleBreeder
eval = ec.simple.SimpleEvaluator
exch = ec.simple.SimpleExchanger

# 20 generations was not enough to observe anything: the earlier runs went flat from
# generation 9 and there was no way to tell a converged population from a hard problem.
# At the measured ~190 games/second, 100 generations x 500 individuals x 2 games is
# roughly nine minutes of wall clock.
generations = 100
quit-on-run-complete = false
checkpoint = false
checkpoint-prefix = ec
checkpoint-modulo = 1

# ---------------------------------------------------------------------
# Population
# ---------------------------------------------------------------------
# 100 was too small. Eleven identical best-of-generation lines in a row is an exhausted
# gene pool, not a difficult search -- with no diversity left there is nothing for
# crossover to recombine. 500 is affordable here and is the standard Koza-style size.
pop.subpop.0.size = 500
pop.subpop.0.duplicate-retries = 100
pop.subpop.0.species = ec.gp.GPSpecies
pop.subpop.0.species.ind = ec.gp.GPIndividual
pop.subpop.0.species.fitness = ec.gp.koza.KozaFitness
pop.subpop.0.species.ind.numtrees = 1
pop.subpop.0.species.ind.tree.0 = ec.gp.GPTree
pop.subpop.0.species.ind.tree.0.tc = tc0

# Depth cap. Koza's default is 17, which is generous; the G1 100 ms budget is the real
# constraint and the last run peaked at 4 ms, so there is considerable headroom. Lower
# this to 8 if per-cycle time starts creeping toward the gate. Note that mean tree size
# grew 19 -> 77 in four generations in an earlier run, so bloat is real here even while
# the time budget stays green -- ec.parsimony.* is available if it becomes a problem.
gp.koza.xover.maxdepth = 12
gp.koza.mutate.maxdepth = 12

# ---------------------------------------------------------------------
# Function set
# ---------------------------------------------------------------------
# nc0 = terminal, nc2 = arity 2, nc4 = arity 4 (defined below for if>).
#
# TERMINALS: each FeatureNode binds by name to a static method in gp.Features.
# FeatureNode resolves parameters BY TYPE, so argument order in Features.java does not
# matter -- (GameState, Unit, int) and (Unit, GameState, int) both bind.
#
# SUFFICIENCY: whatever is not listed here, evolution cannot use. This list IS the
# GP's vocabulary.
#
# NOT LISTED, DELIBERATELY: Features.movesToward(Unit, UnitAction, int, int) takes
# target coordinates rather than a player id, so its two ints cannot be resolved from
# ScoreData and it cannot be a terminal. Exposing it would mean writing an arity-2
# FUNCTION whose children supply tx and ty. Worth raising at the terminal-set review,
# since "move toward a point the tree chooses" is a genuinely different capability.

gp.fs.size = 1
gp.fs.0.name = f0
gp.fs.0.size = 25

# -- functions --
gp.fs.0.func.0 = gp.nodes.Add
gp.fs.0.func.0.nc = nc2
gp.fs.0.func.1 = gp.nodes.Sub
gp.fs.0.func.1.nc = nc2
gp.fs.0.func.2 = gp.nodes.Mul
gp.fs.0.func.2.nc = nc2
gp.fs.0.func.3 = gp.nodes.Div
gp.fs.0.func.3.nc = nc2
gp.fs.0.func.4 = gp.nodes.Min
gp.fs.0.func.4.nc = nc2
gp.fs.0.func.5 = gp.nodes.Max
gp.fs.0.func.5.nc = nc2
gp.fs.0.func.6 = gp.nodes.IfGreater
gp.fs.0.func.6.nc = nc4

# -- ephemeral random constants (the evolved scoring weights) --
gp.fs.0.func.7 = gp.nodes.ScoreERC
gp.fs.0.func.7.nc = nc0
gp.fs.0.func.7.range = 10.0

# -- terminals: action type --
gp.fs.0.func.8 = gp.nodes.FeatureNode
gp.fs.0.func.8.nc = nc0
gp.fs.0.func.8.feature = aIsMove
gp.fs.0.func.9 = gp.nodes.FeatureNode
gp.fs.0.func.9.nc = nc0
gp.fs.0.func.9.feature = aIsHarvest
gp.fs.0.func.10 = gp.nodes.FeatureNode
gp.fs.0.func.10.nc = nc0
gp.fs.0.func.10.feature = aIsReturn
gp.fs.0.func.11 = gp.nodes.FeatureNode
gp.fs.0.func.11.nc = nc0
gp.fs.0.func.11.feature = aIsProduce
gp.fs.0.func.12 = gp.nodes.FeatureNode
gp.fs.0.func.12.nc = nc0
gp.fs.0.func.12.feature = aIsAttack

# -- terminals: produce target --
gp.fs.0.func.13 = gp.nodes.FeatureNode
gp.fs.0.func.13.nc = nc0
gp.fs.0.func.13.feature = aProducesWorker
gp.fs.0.func.14 = gp.nodes.FeatureNode
gp.fs.0.func.14.nc = nc0
gp.fs.0.func.14.feature = aProducesCombat
gp.fs.0.func.15 = gp.nodes.FeatureNode
gp.fs.0.func.15.nc = nc0
gp.fs.0.func.15.feature = aProducesBuilding

# -- terminals: acting unit --
gp.fs.0.func.16 = gp.nodes.FeatureNode
gp.fs.0.func.16.nc = nc0
gp.fs.0.func.16.feature = uIsWorker
gp.fs.0.func.17 = gp.nodes.FeatureNode
gp.fs.0.func.17.nc = nc0
gp.fs.0.func.17.feature = uIsBase
gp.fs.0.func.18 = gp.nodes.FeatureNode
gp.fs.0.func.18.nc = nc0
gp.fs.0.func.18.feature = uIsCombat
gp.fs.0.func.19 = gp.nodes.FeatureNode
gp.fs.0.func.19.nc = nc0
gp.fs.0.func.19.feature = uCarrying

# -- terminals: economy and army --
gp.fs.0.func.20 = gp.nodes.FeatureNode
gp.fs.0.func.20.nc = nc0
gp.fs.0.func.20.feature = myResources
gp.fs.0.func.21 = gp.nodes.FeatureNode
gp.fs.0.func.21.nc = nc0
gp.fs.0.func.21.feature = myWorkerCount
gp.fs.0.func.22 = gp.nodes.FeatureNode
gp.fs.0.func.22.nc = nc0
gp.fs.0.func.22.feature = enemyUnitCount

# -- terminals: spatial --
gp.fs.0.func.23 = gp.nodes.FeatureNode
gp.fs.0.func.23.nc = nc0
gp.fs.0.func.23.feature = distNearestEnemy
gp.fs.0.func.24 = gp.nodes.FeatureNode
gp.fs.0.func.24.nc = nc0
gp.fs.0.func.24.feature = distNearestResource

# Arity-4 node constraint for if>. koza.params defines nc0..nc3 only.
gp.nc.size = 5
gp.nc.4 = ec.gp.GPNodeConstraints
gp.nc.4.name = nc4
gp.nc.4.returns = nil
gp.nc.4.size = 4
gp.nc.4.child.0 = nil
gp.nc.4.child.1 = nil
gp.nc.4.child.2 = nil
gp.nc.4.child.3 = nil

# ---------------------------------------------------------------------
# The problem: what games get played
# ---------------------------------------------------------------------
eval.problem = gp.MicroRTSProblem
eval.problem.data = gp.ScoreData

# TRAINING opponents and maps only. Everything else stays held out for the report.
#
# CURRICULUM. This was WorkerRush, and that was the single biggest thing wrong with the
# earlier runs. No randomly generated tree beats WorkerRush, so the entire population
# lived in the loss band from generation 0 onward: the win band was unreachable, and
# the only gradient available was "lose slightly less badly". Best-of-run sat at 2.37
# for eleven straight generations.
#
# PassiveAI does nothing at all, so a win is genuinely reachable -- Chimera beats it,
# which proves wins exist in the search space and that a draw here is a fitness problem
# rather than an action-space one.
#
# Advance one stage at a time, only once the previous stage produces wins (Hits > 0 and
# best-of-run below 1.0):
#   stage 1  PassiveAI
#   stage 2  PassiveAI, RandomBiasedAI
#   stage 3  PassiveAI, RandomBiasedAI, WorkerRush
# Expect a stage-1 bot to be good at beating PassiveAI and still poor against
# WorkerRush. That is the point of a curriculum, not a failure of it.
eval.problem.opponents = PassiveAI, RandomBiasedAI
eval.problem.maps = maps/8x8/basesWorkers8x8.xml
eval.problem.swap-sides = true

# 3000 is enough for a decided 8x8 game; lower it to speed up early runs.
eval.problem.max-cycles = 3000

# ---------------------------------------------------------------------
# Fitness shaping (see the comment block in MicroRTSProblem)
# ---------------------------------------------------------------------
# Bands: win 0-1, draw 1-2, loss 2-3. These two now only split the LOSS band between
# "survived longer" and "played better"; they are normalised to sum to 1 and no longer
# set band width.
eval.problem.speed-weight = 0.5
eval.problem.margin-weight = 0.25

# Range of SimpleSqrtEvaluationFunction3 means, used to map quality onto 0..1.
# Measured against WorkerRush: observed [0.27, 0.46] while mapping from [0.0, 1.0],
# meaning the quality term was using under a fifth of its range and near-identical
# individuals were scoring near-identically. Widened slightly so early outliers do not
# clamp.
#
# RECALIBRATE FOR THIS OPPONENT. PassiveAI games will report a different range -- the
# calibration line prints after the first 200 games of every run. Copy the reported
# numbers back here and rerun once.
eval.problem.eval-lo = 0.10
eval.problem.eval-hi = 0.90
eval.problem.calibrate-eval = true
eval.problem.repeats = 3

# ---------------------------------------------------------------------
# Statistics + end-of-run benchmark
# ---------------------------------------------------------------------
stat = gp.BenchmarkStatistics
stat.file = $results/microrts.stat

# 'all' runs the full 18-bot scripted panel -- deliberately much wider than the training
# opponent above, so the benchmark shows what generalises rather than what was fitted.
stat.bench-opponents = all
stat.bench-maps = maps/8x8/basesWorkers8x8.xml
stat.bench-games = 10
stat.bench-max-cycles = 3000
